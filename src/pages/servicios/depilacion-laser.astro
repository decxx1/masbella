---
import Layout from '@/layouts/Layout.astro';
import '@/styles/blog.css';
import BreadCrumbs from '@/components/BreadCrumbs.astro';
import PricingTable from '@/components/servicios/PricingTable.astro';  
import Features from '@/components/servicios/ServicesFeatures.astro';
import Tips from '@/components/Tips.astro';
import FaqContainer from '@/components/FaqContainer.astro';
import LaserInfo from '@/components/servicios/LaserInfo.astro';
const { url } = Astro;
---
<Layout 
	title="Más Bella - Depilación Láser"
	canonical="https://masbellamedical.com/servicios/depilacion-laser"
	metaTitle="Más Bella - Depilación Láser para Mujeres y Hombres"
	metaDescription="Depilación láser de diodo de alta potencia e intensidad. Compatible con el sol y apto para todo tipo de pieles. Sin bonos, sesiones sueltas."
	metaImg="https://masbellamedical.com/img/servicios/depilacion-laser-mujer.webp"
>
    <BreadCrumbs title="Depilación Láser" subPage="servicios" />
    
    <section class="blog spad">
        <div class="container mx-auto">
           
            
            <div class="px-4 mb-20">
                <div class="text-center">
                    <h2 class="text-primary-100 text-4xl font-bold mt-3">Descubre la libertad de una piel suave y sin vello</h2>
                    <p class="bg-primary-100 font-medium text-lg text-white p-4 rounded-lg mt-5">Olvídate de métodos tradicionales y disfruta de sesiones rápidas, prácticamente indoloras y con resultados visibles desde las primeras sesiones.</p>
                </div>
            </div>  
            <Features />
            <!-- Sección de precios para mujeres -->
            <section class="col-span-12 py-8 w-full sm:w-96 mx-auto">
                <div class="plan-amigos bg-white rounded-lg shadow sm:shadow-lg p-4 flex sm:flex-row flex-col items-center justify-between">
                    <div class="flex flex-col justify-center items-center">
                        <img src={`${url.origin}/img/laser/friends.svg`} alt="Plan amigos" class="h-16">
                        <span class="font-bold text-primary-100">PLAN AMIGOS</span>
                    </div>
                    <div class="text-7xl font-bold text-primary-100">-20%</div>
                </div>
            </section>
            <div class="grid grid-cols-12 mt-5">
                <PricingTable 
                    title="Precios para Mujeres"
                    image="/img/servicios/depilacion-laser-mujer.webp"
                    imageAlt="Depilación láser para mujeres"
                    prices={[
                        {
                            duration: "25'",
                            service: "INGLES BRASILEÑA COMPLETA + PERIANAL + AXILAS",
                            price: "25€"
                        },
                        {
                            duration: "30'",
                            service: "MEDIA PIERNAS + PIES + INGLES BRASILEÑA COMPLETA + PERIANAL + AXILAS",
                            price: "49€"
                        },
                        {
                            duration: "45'",
                            service: "PIERNAS COMPLETAS + PIES + INGLES BRASILEÑA COMPLETA + PERIANAL + AXILAS",
                            price: "59€"
                        },
                        {
                            duration: "90'",
                            service: "CUERPO COMPLETO sin Brazos",
                            price: "79€"
                        }
                    ]}
                />
                
                <!-- Sección de precios para hombres -->
                <PricingTable 
                    title="Precios para Hombres"
                    image="/img/servicios/depilacion-laser-hombre.webp"
                    imageAlt="Depilación láser para hombres"
                    prices={[
                        {
                            duration: "30'",
                            service: "TORAX + ABDOMEN + HOMBROS",
                            price: "45€"
                        },
                        {
                            duration: "45'",
                            service: "TORAX + ABDOMEN + ESPALDA + LUMBARES + HOMBROS + NUCA",
                            price: "59€"
                        },
                        {
                            duration: "75'",
                            service: "PIERNAS ENTERAS + PIES + TORAX + ABDOMEN + ESPALDA + LUMBARES + HOMBROS + NUCA",
                            price: "79€"
                        },
                        {
                            duration: "120'",
                            service: "CUERPO COMPLETO sin Brazos",
                            price: "99€"
                        }
                    ]}
                />
                <section class="col-span-12 py-8">
                    <LaserInfo />
                </section>
                <!-- Preguntas Frecuentes -->
                <div class="col-span-12 px-4 mt-8">
                    <div class="section-title text-center">
                        <h2 class="text-primary-100">Preguntas Frecuentes</h2>
                    </div>
                    
                    <FaqContainer 
                        faqs={[
                            {
                                ask: "¿El láser duele?",
                                answer: "El láser no duele ya que tiene una punta de frío que se enfría a -10 grados, es prácticamente indoloro."
                            },
                            {
                                ask: "¿Cuántas sesiones necesito para eliminar el vello?",
                                answer: "Las sesiones van a depender del tipo de vello y del color de la piel. Normalmente un tratamiento completo en 12/14 sesiones se elimina en 95% del vello, el resto del 5% es un vello residual."
                            },
                            {
                                ask: "¿Es compatible con el sol?",
                                answer: "Nuestro láser es compatible con el sol. ☀️ Sin embargo, es importante que 3 días no tomes el sol: el día de antes, el día de la cita y el día de después de tu sesión de láser."
                            },
                            {
                                ask: "¿A partir de qué edad mi hijo/a se lo puede hacer?",
                                answer: "Las niñas a partir de los 14 años podrán realizarse el láser siempre y cuando tengan la regla controlada mes a mes. Los niños a partir de los 14 años pueden hacerse el láser sin inconveniente."
                            },
                            {
                                ask: "¿El precio es por bono?",
                                answer: "El precio de nuestros pack es por sesión, nosotros no tenemos bonos."
                            },
                            {
                                ask: "¿Tengo que rasurarme antes de venir?",
                                answer: "Es super importante que te rasures antes de venir a tu cita del láser, ya que si lo hacemos en el momento podemos irritar la piel."
                            },
                            {
                                ask: "¿Estoy tomando medicamento, puedo hacer el láser?",
                                answer: "Nuestro láser es compatible con la mayoría de medicamentos, no obstante es importante avisarle a nuestro técnico que lo verifique."
                            },
                            {
                                ask: "¿Estoy dando el pecho, puedo hacerme el láser?",
                                answer: "Si estás dando el pecho/amamantando a tu bebé tienes que esperar 6 meses para poder realizarte el láser."
                            },
                            {
                                ask: "¿Estoy con la regla, puedo hacerme el láser?",
                                answer: "Si estás con la regla puedes hacerte la sesión del láser, te pones un tampax y sin problemas. (Recuerda no tomar ibuprofeno las 8 horas antes de tu sesión) puedes tomar paracetamol y sin problemas."
                            },
                            {
                                ask: "¿El láser facial me pasan cuchilla? ¿Me crecerá más el vello?",
                                answer: "El láser facial se realiza cada mes, es un vello hormonal por lo que no te crecerá más vello por pasarte cuchilla, ¡SIEMPRE Y CUANDO! Continúes con las sesiones. Si estás decidida a dejar la depilación láser es importante que no te vuelvas a rasurar."
                            },
                            {
                                ask: "¿Si me hago solo una zona me cobran el pack?",
                                answer: "Si te haces una zona que no encuentras en el pack, tenemos también precios por zona suelta."
                            },
                            {
                                ask: "¿Qué pasa si no vengo rasurado/a?",
                                answer: "Si no vienes rasurado, lo tendremos que hacer en cabina dejando más tiempo la sesión y luego te cobraremos un plus por rasurarte (según qué zona es un precio u otro)."
                            },
                            {
                                ask: "¿Qué pasa si me ha dado el sol?",
                                answer: "Si te ha dado el ☀️ y la piel está irritada (roja) no podremos hacerte el láser, ya que la piel está muy sensible y al pasar el láser podremos dejar consecuencias graves."
                            },
                            {
                                ask: "¿Tengo mi piel morena/negra, puedo hacerme el láser?",
                                answer: "Sí, eres apta. Tu tratamiento se estirará en el tiempo ya que tenemos que ir con cuidado porque el láser no distingue si es piel o vello, normalmente para tu piel son 36 sesiones."
                            },
                            {
                                ask: "¿Tengo mi piel blanca pero mis vellos son rubios o pelirrojos, me puedo hacer el láser?",
                                answer: "Sí eres apta. Al igual que las pieles más oscuras, nuestro láser tiene que identificar si tu vello recibe la luz que emite el láser ya que normalmente el vello pelirrojo o inclusive blanco no tiene melanina (color) entonces primero se te hará una prueba para ver si eres apta."
                            },
                            {
                                ask: "¿Qué pasa si dejo mi tratamiento más de 5/6 meses?",
                                answer: "Si abandonas el tratamiento y lo retomas más adelante es como empezar de 0. Pero no te preocupes que al menos las sesiones que te has dado los folículos están \"muertos\" por así decirlo y no crecerá ese vello allí."
                            }
                        ]}
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Tips para depilación láser -->
    <Tips
        title="Tips para depilación láser"
        subTitle1="No te depiles con cera"
        description1="Evitá usar cera o pinzas 3-4 semanas antes"
        subTitle2="Piel limpia y sin productos"
        description2="Asistí sin cremas, desodorante ni maquillaje en la zona a tratar para evitar irritaciones."
        subTitle3="Cuida bien tu piel"
        description3="Para mantenerla sana y receptiva al tratamiento."
    />
</Layout>

<style>
.section-title p {
	color: white;
	background-color: #d80a7c;
	margin-top: 15px;
	font-size: 1rem !important;
	padding: 25px;
	border-radius: 20px;
}

.price-table {
    font-size: 0.9rem;
}

.faq-item {
    transition: all 0.3s ease;
}

.faq-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

@media (max-width: 768px) {
    .price-table {
        font-size: 0.75rem;
    }
}
</style>
