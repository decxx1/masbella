---
import Layout from '@/layouts/Layout.astro';
import BreadCrumbs from '@/components/BreadCrumbs.astro';
import Beneficios from '@/components/Beneficios.astro';
import Tips from '@/components/Tips.astro';
import Consultation from '@/components/Consultation.astro';
import IconBoxes from '@/components/IconBoxes.astro';
import { siteKey } from '@/services/enviroment.js';
---
<Layout
	title="Más Bella - Sobre nosotros"
	canonical="https://masbellamedical.com/about"
	metaTitle="Más Bella - Sobre nosotros"
	metaDescription="Más Bella ofrece un enfoque exclusivamente personalizado en tratamientos estéticos no invasivos y preventivos. Descubre nuestro equipo altamente cualificado"
	metaImg="https://masbellamedical.com/img/mas-bella-modelo.jpg"
>
    <BreadCrumbs title="Sobre Nosotros" />
    <Consultation />
    <IconBoxes />
    <div class="container margenes">
        <div class="section-title text-center">
            <h2 class="text-primary-100">La belleza comienza con el amor propio, ámate y siéntete <em class="text-nowrap">“Más Bella”</em>. Porque lo importante eres tú.</h2>
        </div>
    </div>
    <Beneficios />
    <Tips
        title="Tips para empezar"
        subTitle1="Mantén tu piel hidratada"
        description1="Beber suficiente agua y usar productos hidratantes adecuados para tu tipo de piel pueden mejorar la apariencia y la salud de tu piel."
        subTitle2="Evalúa tus necesidades y objetivos"
        description2="Es importante determinar tus necesidades y objetivos a largo plazo. ¿Quieres reducir arrugas, mejorar la textura de tu piel, o ambos? Un profesional calificado puede ayudarte a identificar tus necesidades y objetivos específicos."
        subTitle3="Conoce tus opciones de tratamiento"
        description3="Aprende sobre los diferentes tipos de tratamientos de estética avanzada disponibles, sus beneficripciones, ventajas y riesgos para tomar una decisión informada."
    />
</Layout>
<!-- recaptcha v3 -->
<script 
    async
    data-category="necessary"
    data-service="<a href='https://policies.google.com/privacy?hl=es-419' target='_blank'>Google</a>"
    src={'https://www.google.com/recaptcha/api.js?render=' + siteKey}
></script>
<style>
    .margenes {
        margin: 80px auto;
    }
    
</style>