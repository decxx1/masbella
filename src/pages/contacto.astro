---
import Layout from '@/layouts/Layout.astro';
import BreadCrumbs from '@/components/BreadCrumbs.astro';
import MapMarker from '@/components/icons/MapMarker.astro';
import Phone from '@/components/icons/Phone.astro';
import Cards from '@/components/contacto/Cards.astro';
import WhatsApp from '@/components/icons/WhatsApp.astro';
import Clock from '@/components/icons/Clock.astro';
import Envelope from '@/components/icons/Envelope.astro';
import Tips from '@/components/Tips.astro';
import ContactForm from '@/components/ContactForm.jsx';
import IconDate from "@/components/icons/Date.astro";
import { 
    telphoneReadble,
    telphoneLinkeable,
    whatsappReadble,
    whatsappLinkeable,
    email,
    address,
    mapUrl,
    schedules,
    mapIframe,
    siteKey,
    dateLink,

    suc1WhatsappReadble,
	suc1WhatsappLinkeable,
	suc1Schedules,
	suc1Address,
	suc1MapUrl,
	suc1MapIframe,
} from '@/services/enviroment.js';

---
<Layout 
	title="Más Bella - Contacto"
	canonical="https://masbellamedical.com/contacto"
	metaTitle="Más Bella - Contacto"
	metaDescription="¿Tienes alguna duda o pregunta sobre nuestros servicios? Contacta con Más Bella ®, La primer cita es gratis, solicita tu cita hoy mismo sin compromiso."
	metaImg="https://masbellamedical.com/img/logo-web.png"
>
    <BreadCrumbs title="Reserva" />
    <section class="bg-[#f8f4f4]">
        <section class="mb-centers">
  <div class="mb-container">
    <h2 class="mb-title">Escoge tu centro</h2>

    <div class="mb-grid">
      <!-- TORRE DEL MAR -->
      <article class="mb-card">
        <span class="mb-pill">Torre del Mar</span>
        <div class="mb-media" role="img" aria-label="Mas Bella Torre del Mar"
             style="background-image:url('https://eu104.flowww.net/142417/custom_app/APP_000000005.JPG');"></div>
        <div class="mb-body">
          <h3>MAS BELLA – Torre del Mar</h3>
          <p>Tu espacio de depilación láser y estética avanzada en la Axarquía. Reserva tu cita en Torre del Mar.</p>
          <a target="_blank" class="mb-btn" href="https://fwa1.flowww.net/142417/2/treatment">Reservar ahora</a>
        </div>
      </article>

      <!-- CÓRDOBA -->
      <article class="mb-card">
        <span class="mb-pill">Córdoba</span>
        <div class="mb-media" role="img" aria-label="Mas Bella Córdoba"
             style="background-image:url('https://eu104.flowww.net/142417/custom_app/APP_000000007.jpg');"></div>
        <div class="mb-body">
          <h3>MAS BELLA – Córdoba</h3>
          <p>Depilación láser de diodo y estética avanzada, con trato cercano y familiar. Reserva tu cita en Córdoba.</p>
          <a target="_blank" class="mb-btn" href="https://fwa1.flowww.net/142417/3/treatment">Reservar ahora</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  :root{
    --mb-pink:#d80a7c;      /* rosa Mas Bella */
    --mb-pink-dark:#d80a7c;
    --mb-text:#d80a7c;
    --mb-muted:#7a7a7a;
    --mb-bg:#fff6fa;
    --mb-radius:18px;
  }

  .mb-centers{padding:clamp(28px,4vw,56px) 16px;background:#fff;}
  .mb-container{max-width:1200px;margin:0 auto;}
  .mb-title{text-align:center;color:var(--mb-text);margin:0 0 28px;}
  .mb-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:24px;}

  .mb-card{position:relative;display:flex;flex-direction:column;border-radius:var(--mb-radius);background:#fff;
    box-shadow:0 10px 24px rgba(233,30,99,.12);overflow:hidden;transition:transform .25s, box-shadow .25s;}
  .mb-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(233,30,99,.18);}

  .mb-pill{position:absolute;z-index:2;top:14px;left:14px;background:#fff;color:var(--mb-pink);
    border:2px solid var(--mb-pink);padding:6px 12px;border-radius:999px;font-weight:600;font-size:13px;
    box-shadow:0 4px 12px rgba(0,0,0,.06);}

  .mb-media{aspect-ratio:16/9;background:var(--mb-bg) center/cover no-repeat;}

  .mb-body{padding:18px 18px 20px;}
  .mb-body h3{
    margin:0 0 8px;
    font-size:20px;
    color:#d80a7c !important; /* Rosa corporativo */
  }
  .mb-body p{margin:0 0 16px;color:var(--mb-muted);line-height:1.5;}

  .mb-card .mb-btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:5px;
    background:var(--mb-pink) !important;color:#fff !important;text-decoration:none;font-weight:700;
    box-shadow:0 10px 18px rgba(233,30,99,.22);transition:background .2s, transform .2s, box-shadow .2s;}
  .mb-card .mb-btn:hover{background:var(--mb-pink-dark) !important;transform:translateY(-1px);
    box-shadow:0 12px 22px rgba(233,30,99,.28);}
  .mb-card .mb-btn:active{transform:translateY(0);}
</style>

    </section>
    <section class="contact spad">
        <div class="container mx-auto px-4">
            <div class="flex sm:justify-center flex-wrap">
				<div class="w-max px-4">
                    <div class="contact__widget">
                        <div class="h-20 w-20 bg-body-light text-primary-100 rounded-full text-center text-2xl  sm:float-left mr-7 leading-[76px]">
                            <Envelope className="inline" />
                        </div>
                        <div class="contact__widget__text">
                            <h5>E-mail</h5>
                            <p><a target="_blank" href={'mailto:' + email}>{email}</a></p>
                        </div>
                    </div>
                </div>
				
                <div class="w-max px-4">
                    <div class="contact__widget">
                        <div class="h-20 w-20 bg-body-light text-primary-100 rounded-full text-center text-2xl sm:float-left mr-7 leading-[76px]">
                            <IconDate className="inline" />
                        </div>
                        <div class="contact__widget__text">
							<h5>Haz reserva</h5>
							<p><a target="_blank" href={dateLink}>Cita Online</a></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="contact__content">
                <div class="max-w-xl mx-auto">
                    
                    <div class="px-4">
                        <ContactForm client:load />
                    </div>
                </div>
            </div>
        </div>
    </section>
    <Cards
		title="Málaga - Torre del Mar"
		iframe={mapIframe}
	>
		<div class="col-span-12 sm:col-span-7 border border-primary-50 rounded-lg shadow p-4 md:mx-4">
			<ul class="text-lg">
				<li class="mb-2"><MapMarker className="inline w-5 h-5 text-primary-100 mr-3" /> <a href={mapUrl} target="_blank" rel="noopener noreferrer">{address}</a></li>
				<li class="mb-2"><WhatsApp className="inline w-5 h-5 mr-3" /> <a onclick="gtag('event','conversion',{'send_to':'AW-175290900048/Fg0OCMaljp8bElDGwgZB'});" href={'https://wa.me/34'+whatsappLinkeable} target="_blank" rel="noopener noreferrer">{whatsappReadble}</a></li>
				<li class="mb-2"><Phone className="inline text-primary-100 w-5 h-5 mr-3" /> <a href={'tel:'+telphoneLinkeable} target="_blank" rel="noopener noreferrer">{telphoneReadble}</a></li>
				<li class=""><Clock className="inline w-5 h-5 text-primary-100 mr-4" />{schedules}</li>
			</ul>
		</div>
	</Cards>
	<Cards
		title="Córdoba - Poniente Sur"
		iframe={suc1MapIframe}
	>
		<div class="col-span-12 sm:col-span-7 border border-primary-50 rounded-lg shadow p-4 md:mx-4">
			<ul class="text-lg">
				<li class="mb-2"><MapMarker className="inline w-5 h-5 text-primary-100 mr-3" /> <a href={suc1MapUrl} target="_blank" rel="noopener noreferrer">{suc1Address}</a></li>
				<li class="mb-2"><WhatsApp className="inline w-5 h-5 mr-3" /> <a onclick="gtag('event','conversion',{'send_to':'AW-175290900048/Fg0OCMaljp8bElDGwgZB'});" href={'https://wa.me/34'+suc1WhatsappLinkeable} target="_blank" rel="noopener noreferrer">{suc1WhatsappReadble}</a></li>
				<li class=""><Clock className="inline w-5 h-5 text-primary-100 mr-4" />{suc1Schedules}</li>
			</ul>
		</div>
	</Cards>
    <Tips
        title="Tips para contactarnos"
        subTitle1="¡Comunícate con nosotros!"
        description1="No dudes en preguntar sobre cualquier servicio o tratamiento que te interese."
        subTitle2="Haz una cita previa"
        description2="Para asegurarte de que tengamos tiempo para atenderte."
        subTitle3="Infórmanos sobre tus necesidades y expectativas"
        description3="Para que podamos personalizar tu tratamiento."
    />
</Layout>

    <!-- recaptcha v3 -->
    <script 
        async
        data-category="necessary"
        data-service="<a href='https://policies.google.com/privacy?hl=es-419' target='_blank'>Google</a>"
        src={'https://www.google.com/recaptcha/api.js?render=' + siteKey}
    ></script>