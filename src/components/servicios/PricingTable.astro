---
interface PriceItem {
    duration: string;
    service: string;
    price: string;
}

interface Props {
    title: string;
    image: string;
    imageAlt: string;
    prices: PriceItem[];
}

const { title, image, imageAlt, prices } = Astro.props;
const url = Astro.url;

function parsePrice(price: string) {
    const match = price.match(/^(\d+)(,\d+)?(€)?$/);
    if (!match) return { whole: price, cents: '', symbol: '' };
    return {
        whole: match[1],
        cents: match[2] ?? '',
        symbol: match[3] ?? '',
    };
}
---

<div class="col-span-12 md:col-span-6 px-4 mb-8">
    <div class="col-span-12 px-4 mt-8">
        <div class="section-title text-center">
            <h2 class="text-primary-100">{title}</h2>
        </div>
    </div>
    <img src={`${url.origin}${image}`} alt={imageAlt} class="w-full rounded-lg shadow-lg mb-6">
    
    <div class="price-table bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="grid grid-cols-12 bg-primary-100 text-white py-3">
            <div class="col-span-2 text-center font-bold">Tiempo</div>
            <div class="col-span-8 text-center font-bold">Servicio</div>
            <div class="col-span-2 text-center font-bold">Precio</div>
        </div>
        
        {prices.map((item) => (
            <div class="grid grid-cols-12 border-b py-3 hover:bg-gray-50">
                <div class="col-span-2 text-center flex items-center justify-center">
                    
                    <span class="bg-primary-100 text-white rounded-full w-12 h-12 flex items-center justify-center font-bold">
                        {item.duration}
                    </span>
                </div>
                <div class="col-span-8 px-4 flex items-center">
                    {item.service}
                </div>
                <div class="col-span-2 text-center flex items-center justify-center font-bold">
                    {(() => {
                        const { whole, cents, symbol } = parsePrice(item.price);
                        return (
                            <span class="price-badge bg-primary-100 text-white rounded-full flex items-center justify-center">
                                <span class="price-display">
                                    <span class="price-whole">{whole}</span>
                                    {cents && <span class="price-cents">{cents}</span>}
                                    {symbol && <span class="price-symbol">{symbol}</span>}
                                </span>
                            </span>
                        );
                    })()}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .price-badge {
        width: 3.25rem;
        height: 3.25rem;
        min-width: 3.25rem;
        min-height: 3.25rem;
        padding: 0.15rem;
    }

    .price-display {
        display: inline-flex;
        align-items: flex-start;
        justify-content: center;
        line-height: 1;
        font-size: 0.8125rem;
        letter-spacing: -0.02em;
    }

    .price-whole {
        font-weight: 700;
    }

    .price-cents {
        font-size: 0.7em;
        font-weight: 600;
        line-height: 1;
        margin-top: 0.08em;
    }

    .price-symbol {
        font-size: 1em;
        font-weight: 600;
        align-self: flex-end;
        margin-bottom: 0.06em;
        margin-left: 0.04em;
    }

    @media (min-width: 640px) {
        .price-badge {
            width: 3.5rem;
            height: 3.5rem;
            min-width: 3.5rem;
            min-height: 3.5rem;
        }

        .price-display {
            font-size: 0.875rem;
        }
    }
</style>
