---
import '@/styles/footer.css';
import Facebook from '@/components/icons/Facebook.astro';
import Instagram from '@/components/icons/Instagram.astro';
import MapMarker from '@/components/icons/MapMarker.astro';
import Phone from '@/components/icons/Phone.astro';
import WhatsApp from '@/components/icons/WhatsApp.astro';
import Envelope from '@/components/icons/Envelope.astro';

import { 
    telphoneReadble,
    telphoneLinkeable,
    whatsappReadble,
    whatsappLinkeable,
    email,
    address,
    schedules,
    instagram,
    facebook,
    mapUrl,

} from '@/services/enviroment.js';
const { url } = Astro;
---
<script>
    //obtener el año actual
    const year = new Date().getFullYear();
    document.getElementById('year').innerHTML = year.toString();

</script>
<footer class="footer">
    <div class="footer__top" >
        <div class="container mx-auto">
            <div class="grid grid-cols-12">
                <div class="col-span-12 md:col-span-4">
                    <div class="footer__logo">
                        <a href="./"><img src={`${url.origin}/img/logo-blanco.png`} alt="logo blanco de más bella" style="width:160px"></a>
                    </div>
                </div>
                <div class="col-span-12 md:col-span-8 lg:col-span-4">
                    <div class="footer__newslatter text-center">
                        <p class="text-white text-bold" style="font-size:18px;">La belleza comienza en el amor propio, ámate y siéntete <strong>Más Bella</strong> porque lo importante eres tú</p>
                    </div>
                </div>
                <div class="col-span-12 lg:col-span-4">
                    <div class="footer__social">
                        <a target="_blank" href={instagram}>
                            <Instagram className="inline" />
                        </a>
                        <a target="_blank" href={facebook}>
                            <Facebook className="inline" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container mx-auto">
        <div class="grid grid-cols-12">
            <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-2 px-4">
                <div>
                    <h5 class="text-white text-xl font-bold mb-6">Enlaces útiles</h5>
                    <ul class="text-white text-sm">
                        <li class="mb-2"><a href="./" class="hover:text-black hover:font-semibold">Inicio</a></li>
                        <li class="mb-2"><a href="./about" class="hover:text-black hover:font-semibold">Sobre Nosotros</a></li>
                        <li class="mb-2"><a href="./servicios" class="hover:text-black hover:font-semibold">Servicios</a></li>
                        <li class="mb-2"><a href="./contacto" class="hover:text-black hover:font-semibold">Contacto</a></li>
                        <li class="mb-2">
                            <button 
                                class="cursor-pointer text-left hover:text-black hover:font-semibold"
                                type="button"
                                data-cc="show-preferencesModal"
                            >
		                        Declaración de cookies
                            </button>
                        </li>
                        <li class="mb-2"><a href="./aviso-legal" class="hover:text-black hover:font-semibold">Aviso Legal</a></li>
                        <li class="mb-2"><a href="./politica-privacidad" class="hover:text-black hover:font-semibold">Política de Privacidad</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-2 px-4">
                <div>
                    <h5 class="text-white text-xl font-bold mb-6">Horarios</h5>
                    <p class="text-white">{schedules}</p>
                </div>
            </div>
            <div class="col-span-12 md:col-span-6 lg:col-span-4 px-4">
                <div>
                    <h5 class="text-white text-xl font-bold mb-6">Contactenos</h5>
                    <ul class="text-white">
                        <li class="mb-6"><a target="_blank" class="hover:font-semibold hover:text-black" href={'mailto:' + email}>
                            <Envelope className="inline mr-3" />
                            {email}</a>
                        </li>
                        <li class="mb-4"><a class="hover:font-semibold hover:text-black" href="./centros#cordoba">
                            <MapMarker className="inline mr-3" />
                            Córdoba</a>
                        </li>
                        <li class="mb-4"><a class="hover:font-semibold hover:text-black" href="./centros#malaga">
                            <MapMarker className="inline mr-3" />
                            Málaga</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-span-12 sm:col-span-6 md:col-span-12 lg:col-span-4 px-4">
                <h5 class="text-white text-xl font-bold mb-6 md:text-center lg:text-left">Centros Más Bella ®</h5>
                <div class="footer__map">
                    <a href="centros/"><img class="mx-auto w-11/12 sm:w-10/12 md:w-7/12 lg:w-full hover:scale-105" loading="lazy" src="/img/map/map_full_white.svg" alt="mapa MasBella"/></a>
                </div>
            </div>
        </div>
        <p class="text-sm text-white text-center max-lg:mt-6 md:max-lg:pb-12">Más Bella ® <span id="year"></span>  - Marca registrada</p>
    </div>
    <div class="bg-[#b71b6d] py-6 mt-8 max-sm:pb-20">
        <div class="container mx-auto">
            <div class="text-center text-base">
                <p class="text-gray-200">Diseñado por <a class="text-white hover:font-bold hover:text-white" target="_blank" href="https://manejoweb.com.ar/">ManejoWeb</a></p>
            </div>
        </div>
    </div>
</footer>